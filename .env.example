# Copy this file to .env and fill in the values.
# These map to food_cpg_intelligence.config.Settings via the FCPG_ prefix.

# --- Anthropic (Claude API for evaluation & synthetic data) ---
FCPG_ANTHROPIC_API_KEY=sk-ant-...

# --- Paths (defaults usually fine) ---
# FCPG_DATA_DIR=data
# FCPG_MODELS_DIR=models

# --- Embedding ---
# FCPG_EMBEDDING_MODEL=nomic-ai/nomic-embed-text-v1.5
# FCPG_EMBEDDING_DIM=768

# --- Vector Store ---
# FCPG_VECTOR_STORE_BACKEND=chromadb  # or "qdrant"

# --- Fine-tuning ---
# FCPG_BASE_MODEL=mistralai/Mistral-7B-Instruct-v0.3
# FCPG_LORA_RANK=16
# FCPG_LORA_ALPHA=32

# --- Serving ---
# FCPG_API_HOST=0.0.0.0
# FCPG_API_PORT=8000
