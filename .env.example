# Copy this file to .env and fill in the values.
# These map to food_cpg_intelligence.config.Settings via the FCPG_ prefix.

# --- Environment ("local" for Mac, "colab" for Google Colab) ---
# FCPG_ENVIRONMENT=local

# --- Anthropic (Claude API for evaluation & synthetic data) ---
FCPG_ANTHROPIC_API_KEY=sk-ant-...

# --- Paths (defaults usually fine for local development) ---
# FCPG_DATA_DIR=data
# FCPG_RAW_DATA_DIR=data/raw/SKUFood AI Project
# FCPG_NEWSLETTERS_DIR=data/raw/SKUFood AI Project/SKUFood Newsletters
# FCPG_PROCESSED_DIR=data/processed
# FCPG_TRAINING_DIR=data/training
# FCPG_EVALUATION_DIR=data/evaluation
# FCPG_EMBEDDINGS_DIR=data/embeddings
# FCPG_MODELS_DIR=models

# --- Colab (set these when running in Google Colab) ---
# FCPG_COLAB_BASE_PATH=/content/drive/MyDrive/food-cpg-intelligence

# --- Embedding ---
# FCPG_EMBEDDING_MODEL=nomic-ai/nomic-embed-text-v2-moe
# FCPG_EMBEDDING_DIM=768

# --- Vector Store ---
# FCPG_VECTOR_STORE_BACKEND=chromadb  # or "qdrant"

# --- Fine-tuning ---
# FCPG_BASE_MODEL=Qwen/Qwen3.5-9B  # alternatives: google/gemma-3-4b-it, Qwen/Qwen3.5-4B
# FCPG_LORA_RANK=16
# FCPG_LORA_ALPHA=32

# --- Models (inference) ---
# FCPG_CLAUDE_MODEL=claude-sonnet-4-6
# FCPG_OLLAMA_MODEL=  # set after fine-tuning + MLX conversion

# --- Serving ---
# FCPG_API_HOST=0.0.0.0
# FCPG_API_PORT=8000

# --- Audio ingestion (Phase 1 voice fine-tune pipeline) ---
# Required: HF token with pyannote/speaker-diarization-3.1 license accepted at
# https://hf.co/pyannote/speaker-diarization-3.1
FCPG_HUGGINGFACE_TOKEN=hf_xxx
# FCPG_AUDIO_RAW_DIR=data/raw/audio
# FCPG_AUDIO_PROCESSED_DIR=data/processed/audio
# FCPG_AUDIO_CONFIG_PATH=configs/audio.yaml
# FCPG_PETER_REFERENCE_CLIP=data/raw/audio/peter_reference.wav
